{
  "info": {
    "name": "YTC Global Backend API",
    "_postman_id": "ytc-global-backend-api-v1",
    "description": "Comprehensive Postman collection for YTC Global Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@yourdomain.com\",\n  \"password\": \"choose_a_strong_password_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Admin Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"choose_a_strong_password_here\",\n  \"newPassword\": \"choose_a_strong_password_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            }
          }
        },
        {
          "name": "Logout Admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Public Leads & Applications",
      "item": [
        {
          "name": "Create Public Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"consultation\",\n  \"name\": \"Aarav Sharma\",\n  \"phone\": \"+91 98765 43210\",\n  \"email\": \"aarav@example.com\",\n  \"country\": \"Canada\",\n  \"course\": \"Computer Science\",\n  \"message\": \"Interested in Fall 2026 intake.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads"]
            }
          }
        },
        {
          "name": "Submit Job Application",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Rohan Deshmukh", "type": "text" },
                { "key": "phone", "value": "+91 98111 22233", "type": "text" },
                { "key": "email", "value": "rohan@example.com", "type": "text" },
                { "key": "currentCity", "value": "Mumbai", "type": "text" },
                { "key": "jobCategory", "value": "IT and Engineering", "type": "text" },
                { "key": "preferredCountry", "value": "Germany", "type": "text" },
                { "key": "experience", "value": "4 Years", "type": "text" },
                { "key": "message", "value": "Senior Frontend Engineer with React expertise.", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Leads",
      "item": [
        {
          "name": "List Leads (Paged & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/leads?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "leads"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Export Leads to CSV",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/leads/export",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "leads", "export"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Dashboard Stats",
      "item": [
        {
          "name": "Get Dashboard Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Content Resources",
      "item": [
        {
          "name": "Get Countries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/countries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "countries"]
            }
          }
        },
        {
          "name": "Get Single Country (by slug)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/countries/canada",
              "host": ["{{baseUrl}}"],
              "path": ["api", "countries", "canada"]
            }
          }
        },
        {
          "name": "Get Universities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/universities?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "universities"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "Get Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"]
            }
          }
        },
        {
          "name": "Get Testimonials",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/testimonials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "testimonials"]
            }
          }
        },
        {
          "name": "Get FAQs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "faqs"]
            }
          }
        },
        {
          "name": "Get Partners",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/partners",
              "host": ["{{baseUrl}}"],
              "path": ["api", "partners"]
            }
          }
        },
        {
          "name": "Get Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"]
            }
          }
        }
      ]
    },
    {
      "name": "Uploads (Cloudinary)",
      "item": [
        {
          "name": "Upload Image to Cloudinary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/upload/image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "upload", "image"]
            }
          }
        },
        {
          "name": "Delete Image from Cloudinary",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicId\": \"ytc/images/sample_public_id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/upload/image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "upload", "image"]
            }
          }
        }
      ]
    }
  ]
}

